{
  "name": "dsh-pdf",
  "version": "0.1.1",
  "description": "PDF toolbox for DeepSeek Harness: extract text, metadata, and page ranges from PDF files (local parsing, no API key).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "COMPATIBILITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "pdf"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunshine-lang/dsh-pdf.git"
  },
  "homepage": "https://github.com/sunshine-lang/dsh-pdf",
  "bugs": {
    "url": "https://github.com/sunshine-lang/dsh-pdf/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "0.1.5-rc.2 || 0.1.6-alpha.2",
      "node": ">=22.19",
      "dshReleases": {
        "0.1.5-rc.2": "compatible",
        "0.1.6-alpha.1": "unknown",
        "0.1.6-alpha.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2 || ^0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
